{
  "expo": {
    "name": "haru-diary",
    "slug": "haru-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "harudiary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "일기에 첨부할 사진을 선택하기 위해 사진 라이브러리에 접근합니다.",
        "NSCameraUsageDescription": "일기에 첨부할 사진을 촬영하기 위해 카메라를 사용합니다."
      },
      "bundleIdentifier": "com.kwak.dev.harudiary"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.kwak.dev.harudiary"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-voice/voice",
      "./plugins/withSpeechRecognitionQuery",
      "@sentry/react-native",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "일기를 잠금 해제하기 위해 Face ID를 사용합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 일기에 자동으로 기록하기 위해 위치를 사용합니다."
        }
      ],
      "expo-notifications",
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
